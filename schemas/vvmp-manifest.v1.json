{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vvmp.org/schemas/vvmp-manifest.v1.json",
  "title": "VVMP Manifest v1 Draft",
  "type": "object",
  "required": [
    "manifest_version",
    "manifest_id",
    "video",
    "creation",
    "sources",
    "prompts",
    "tools",
    "assets",
    "timeline",
    "edits",
    "guardrails",
    "rights",
    "render",
    "publication",
    "redactions",
    "signatures",
    "links",
    "extensions"
  ],
  "properties": {
    "manifest_version": {
      "type": "string"
    },
    "manifest_id": {
      "type": "string"
    },
    "video": {
      "type": "object",
      "required": [
        "video_id",
        "title",
        "created_at",
        "creator_type",
        "visibility",
        "final_asset"
      ],
      "properties": {
        "video_id": {
          "type": "string"
        },
        "trust_code": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "creator_type": {
          "type": "string"
        },
        "content_type": {
          "type": "string"
        },
        "visibility": {
          "type": "string"
        },
        "final_asset": {
          "type": "object",
          "required": ["format", "duration_seconds", "sha256"],
          "properties": {
            "format": {
              "type": "string"
            },
            "duration_seconds": {
              "type": "number"
            },
            "sha256": {
              "type": "string"
            }
          }
        }
      }
    },
    "creation": {
      "type": "object",
      "required": ["workflow", "human_oversight_level"],
      "properties": {
        "workflow": {
          "type": "string"
        },
        "human_oversight_level": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "source_type", "visibility"],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "canonical_ref": {
            "type": "string"
          },
          "display_text": {
            "type": "string"
          },
          "visibility": {
            "type": "string"
          }
        }
      }
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["prompt_id", "prompt_type", "visibility"],
        "properties": {
          "prompt_id": {
            "type": "string"
          },
          "prompt_type": {
            "type": "string"
          },
          "visibility": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool_id", "tool_type", "purpose"],
        "properties": {
          "tool_id": {
            "type": "string"
          },
          "tool_type": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "assets": {
      "type": "array"
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segment_id", "time_range", "claim_type"],
        "properties": {
          "segment_id": {
            "type": "string"
          },
          "time_range": {
            "type": "object",
            "required": ["start", "end"],
            "properties": {
              "start": {
                "type": "number"
              },
              "end": {
                "type": "number"
              }
            }
          },
          "claim_type": {
            "type": "string"
          }
        }
      }
    },
    "edits": {
      "type": "array"
    },
    "guardrails": {
      "type": "array"
    },
    "rights": {
      "type": "array"
    },
    "render": {
      "type": "object"
    },
    "publication": {
      "type": "object"
    },
    "redactions": {
      "type": "array"
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signature_id", "type", "signer"],
        "properties": {
          "signature_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "signer": {
            "type": "string"
          },
          "signed_at": {
            "type": "string"
          },
          "manifest_hash": {
            "type": "string"
          }
        }
      }
    },
    "links": {
      "type": "object"
    },
    "extensions": {
      "type": "array"
    }
  }
}
