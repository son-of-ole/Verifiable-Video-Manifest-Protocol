{
  "name": "@vvmp/trust-schema",
  "version": "0.1.3",
  "description": "Packaged VVMP schemas, JSON-LD context, registries, examples, and schema validation helpers.",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./schemas/*": "./schemas/*",
    "./contexts/*": "./contexts/*",
    "./examples/*": "./examples/*",
    "./registries/*": "./registries/*"
  },
  "files": [
    "dist",
    "schemas",
    "contexts",
    "examples",
    "registries"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/son-of-ole/Verifiable-Video-Manifest-Protocol.git",
    "directory": "packages/trust-schema"
  },
  "bugs": {
    "url": "https://github.com/son-of-ole/Verifiable-Video-Manifest-Protocol/issues"
  },
  "homepage": "https://github.com/son-of-ole/Verifiable-Video-Manifest-Protocol#readme",
  "keywords": [
    "vvmp",
    "json-schema",
    "json-ld",
    "video",
    "provenance"
  ],
  "dependencies": {
    "@vvmp/trust-core": "0.1.3"
  },
  "peerDependencies": {
    "@vvmp/trust-core": "0.1.3"
  }
}
