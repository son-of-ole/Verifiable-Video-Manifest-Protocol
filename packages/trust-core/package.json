{
  "name": "@vvmp/trust-core",
  "version": "0.1.3",
  "description": "Core VVMP manifest types, canonicalization, validation, summaries, and recovery helpers.",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/son-of-ole/Verifiable-Video-Manifest-Protocol.git",
    "directory": "packages/trust-core"
  },
  "bugs": {
    "url": "https://github.com/son-of-ole/Verifiable-Video-Manifest-Protocol/issues"
  },
  "homepage": "https://github.com/son-of-ole/Verifiable-Video-Manifest-Protocol#readme",
  "keywords": [
    "vvmp",
    "video",
    "provenance",
    "c2pa",
    "manifest"
  ]
}
